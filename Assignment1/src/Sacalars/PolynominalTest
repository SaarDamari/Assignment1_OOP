import org.junit.jupiter.api.Test;

import static org.junit.jupiter.api.Assertions.*;


public class testPolynomial {
    // Create an instances of Polynomial for testing
    Polynomial polynomial1;
    Polynomial polynomial2;
    Polynomial polynomial3;

    @Before
    public void testBuild(){
        // Test case 1: Test a simple polynomial without fractions
        polynomial1 = Polynomial.build("1 3 2");


        // Test case 2: Test a polynomial with fractions
        polynomial2 = Polynomial.build("5 0 -1/2 2/3");


        // Test case 3: Test a polynomial with negative coefficients
        polynomial3 = Polynomial.build("-1 -3 -2");

    }
    @Test
    public void testToString() {
        assertEquals("1 + 3x + 2x^2 ", polynomial1.toString());
        assertEquals(" 5 - 1/2x^2 + 2/3x^3", polynomial2.toString());
        assertEquals("- 1  - 3x - 2x^2", polynomial3.toString());
    }

    @Test
    public void testAdd() {
        // Perform addition of polynomial1 and polynomial2
        Polynomial sum = polynomial1.add(polynomial2);

        // Assert the result
        assertEquals(" 6 + 3x + 3/2x^2 + 2/3x^3", sum.toString());

    }
    @Test
    public void testMul() {
        // Perform multiplication of polynomial1 and polynomial2
        Polynomial product = polynomial1.mul(polynomial2);

        // Assert the result
        assertEquals("5 + 15x + 19/2x^2 - 5/6x^3 + x^4 + 4/3x^5", product.toString());

    }
    @Test
    public void testEvaluate() {
        Polynomial polynomial1 = Polynomial.build("1 3 2");
        // Evaluate the polynomial at a specific scalar value, say x = 2
        Scalar result = polynomial1.evaluate(new Integer(2)); // Assuming Scalar is an Integer

        // Assert the result
        assertEquals(new Integer(15), result);

    }
    @Test
    public void testEquals() {
        // Test polynomials that are equal
        assertTrue(polynomial1.equals(polynomial1));

        // Test polynomials that are not equal
        assertFalse(polynomial1.equals(polynomial3));

        // Test null comparison
        assertFalse(polynomial1.equals(null));

        // Test comparison with different type
        assertFalse(polynomial1.equals("not a polynomial"));

    }

    @Test
    public void testDerivative() {
        // Compute the derivative of polynomial1
        Polynomial derivative = polynomial1.derivative();

        // Assert the result
        assertEquals("3 + 4x", derivative.toString());
    }

}

